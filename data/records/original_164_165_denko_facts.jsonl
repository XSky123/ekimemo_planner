{"detail_page_probe": {"colspan_count": 6, "detail_hash": "ec6598be849b560a271b151f50f6d8db796b0f9cd788e410295d00853bf5f822", "detail_title": "新津えつこ", "headings": [{"tag": "h1", "text": "新津えつこ"}, {"tag": "h2", "text": "プロフィール"}, {"tag": "h2", "text": "セリフ"}, {"tag": "h2", "text": "スキル"}, {"tag": "h2", "text": "ステータス詳細"}, {"tag": "h2", "text": "ラッピング"}, {"tag": "h2", "text": "名前について"}, {"tag": "h2", "text": "ステータスについて"}, {"tag": "h2", "text": "スキルについて"}, {"tag": "h2", "text": "その他"}, {"tag": "h2", "text": "コメント"}, {"tag": "h2", "text": "情報提供"}], "needs_table_matrix": true, "rowspan_count": 7, "skill_like_tables": [{"first_rows": [["発動条件・効果", "アクティベーションタイプ", "備考"], ["編成内のでんこが全員heat属性のとき、アクセスされたでんこのHP回復", "でんこにおまかせ", "1回発動すると3分間のクールタイムに入る"]], "row_count": 2, "table_index": 5}, {"first_rows": [["スキルLv", "コメント", "効果", "クールタイム", "発動率"], ["Lv.1 (でんこLv. 5)", "編成しているでんこがすべてheat属性の場合、編成内のでんこがアクセスされてダメージを受けたとき、アクセスされたでんこのHPを回復します。効果量はアクセスされたでんこがリンクしている駅のうち、最も長いリンク時間に応じて増加します(上限60分)。一度発動したらクールタイムに入ります。成長すると、えつこの物を大切にする力が高まり、効果量が増加していきます。", "HP回復 0%～7.2%", "3分", "100%"], ["Lv.2 (でんこLv.15)", "編成しているでんこがすべてheat属性の場合、編成内のでんこがアクセスされてダメージを受けたとき、アクセスされたでんこのHPを回復します。効果量はアクセスされたでんこがリンクしている駅のうち、最も長いリンク時間に応じて増加します(上限60分)。一度発動したらクールタイムに入ります。えつこは、物静かで上品な佇まいのでんこ。ちょっぴり近寄りがたい雰囲気があるのですが……実は小さい子と仲良くなりたいみたいで、オコジョのぬいぐるみ「オコ」と「オコジ」を持って話しかけようと頑張っているのだとか……小さい子の笑顔を見ると、なんだか少し表情がやわらかくなるみたいですよ♪", "HP回復 0%～9%", "3分", "100%"]], "row_count": 9, "table_index": 7}, {"first_rows": [["第～弾", "ラッピング名", "効果", "効果", "効果"], ["第～弾", "ラッピング名", "ATK", "DEF", "スキル"], ["-", "スペシャルフィルムチェンジ", "+5%", "+5%", "-"]], "row_count": 3, "table_index": 11}], "source_url": "https://newekimemo.wiki.fc2.com/wiki/%E6%96%B0%E6%B4%A5%E3%81%88%E3%81%A4%E3%81%93", "table_count": 12}, "growth": {"is_vu_available": false, "level_cap": null, "mileage_final_ap": null, "mileage_final_hp": null, "vu_changes": []}, "identity": {"aliases": [], "attribute": "heat", "color": "赤", "denko_id": "original:165", "detail_url": "https://newekimemo.wiki.fc2.