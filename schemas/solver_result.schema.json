{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solver_result.schema.json",
  "title": "SolverResult",
  "description": "A cacheable, explainable Step4 constrained-team result. It is a derived recommendation, never a new skill fact.",
  "type": "object",
  "required": ["result_version", "result_meta", "request", "teams", "candidate_summary"],
  "properties": {
    "result_version": { "type": "string" },
    "result_meta": {
      "type": "object",
      "required": ["source_profiles_hash", "generated_at", "solver_version"],
      "properties": {
        "source_profiles_hash": { "type": "string" },
        "generated_at": { "type": "string" },
        "solver_version": { "type": "string" },
        "cache_key": { "type": "string" },
        "limitations_zh": { "type": "array", "items": { "type": "string" } }
      }
    },
    "request": { "type": "object" },
    "candidate_summary": { "type": "object" },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["team_id", "members", "metrics", "active_components", "inactive_components", "constraints_check"],
        "properties": {
          "team_id": { "type": "string" },
          "members": { "type": "array", "items": { "type": "object" } },
          "metrics": { "type": "object" },
          "active_components": { "type": "array", "items": { "type": "object" } },
          "inactive_components": { "type": "array", "items": { "type": "object" } },
          "constraints_check": { "type": "object" }
        }
      }
    }
  }
}
